# PictShare configuration for docker compose.
#   cp .env.example .env
# Every option is optional; an empty value means "use the built-in default" (given in brackets).
# Values are written into single-quoted PHP strings at container start:
# do not use ' or newlines in values. Secrets belong only in your .env, never in git.
# More details: rtfm/CONFIG.md

# ---------------------------------------------------------------- general
# Public URL shown to users for each upload. Must end with a slash.
URL=http://localhost:8080/
# Title of the web page [PictShare]
TITLE=PictShare
# Host port the container is published on (compose only) [8080]
HTTP_PORT=8080
# Max upload size in MB [100]
MAX_UPLOAD_SIZE=100
# Skip fixing file permissions on container start [false]
SKIP_FILEPERMISSIONS=false

# ---------------------------------------------------------------- security
# Password of the admin panel at /admin. Empty = admin panel disabled.
ADMIN_PASSWORD=
# Only these IPs/CIDRs (comma separated, IPv4/IPv6) may upload and open the admin panel. Empty = everyone.
ALLOWED_SUBNET=
# If set, every upload needs this code (GET/POST field "uploadcode")
UPLOAD_CODE=
# Appending "delete_<code>" to any file URL deletes it
MASTER_DELETE_CODE=
# This single IP may delete any file without a delete code
MASTER_DELETE_IP=
# Whitelist of content controllers, comma separated, uppercase:
# IMAGE,SVG,TEXT,VIDEO,URL,HTML. Empty = all except HTML.
CONTENTCONTROLLERS=
# Sent as Access-Control-Allow-Origin header, eg * or https://your.app. Empty = not sent.
CORS_ALLOW_ORIGIN=
# Log the IP of every uploader to data/uploads.csv [false]
LOG_UPLOADER=false
# Log every view to logs/app.log. Resource heavy, for debugging only [false]
LOG_VIEWS=false

# ---------------------------------------------------------------- HTML hosting
# DANGER: serves arbitrary HTML/JS on this domain to everyone holding HTML_UPLOAD_CODE.
# Treat that code like an admin password. Needs HTML in CONTENTCONTROLLERS if that is set.
# Stays disabled while the code is empty. See rtfm/CONFIG.md.
HTML_HOSTING_ENABLED=false
HTML_UPLOAD_CODE=

# ---------------------------------------------------------------- images and video
# JPEG quality 0-100 [90]
JPEG_COMPRESSION=90
# PNG compression 0-9, does not affect quality [6]
PNG_COMPRESSION=6
# Serve JPGs as WebP if the client supports it [false]
ALWAYS_WEBP=false
# Serve images as AVIF if the client supports it [false]
ALWAYS_AVIF=false
# Allow scaling images above their original resolution [true]
ALLOW_BLOATING=true
# Path to the ffmpeg binary [/usr/bin/ffmpeg]
FFMPEG_BINARY=/usr/bin/ffmpeg

# ---------------------------------------------------------------- multiple domains
# Domains (comma separated) this instance answers to. Only needed together with SPLIT_DATA_DIR.
ALLOWED_DOMAINS=
# Keep a separate data folder per domain from ALLOWED_DOMAINS [false]
SPLIT_DATA_DIR=false

# ---------------------------------------------------------------- caching
# Redis inside the container caches url -> file mappings. Disabling slows PictShare down a lot. [true]
REDIS_CACHING=true
# Redis host or socket path [/run/redis/redis.sock = the built-in Redis]
REDIS_SERVER=
# Redis port [6379]
REDIS_PORT=6379

# ---------------------------------------------------------------- storage: alternative folder
# Copy every upload to this path too (eg an NFS mount); also searched for missing files.
ALT_FOLDER=

# ---------------------------------------------------------------- storage: S3 compatible
# Files missing locally are fetched from here, new uploads are pushed here.
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Endpoint of S3 compatible storage (Garage, MinIO, ...). Empty for AWS.
S3_ENDPOINT=
# Region of the bucket (Garage default: us-east-1) [us-east-1]
S3_REGION=

# ---------------------------------------------------------------- storage: FTP
FTP_SERVER=
# [21]
FTP_PORT=21
FTP_USER=
FTP_PASS=
# Base path, must end with a slash, eg /web/pictshare/
FTP_BASEDIR=
# [true]
FTP_PASSIVEMODE=true
# FTPS, not sFTP [false]
FTP_SSL=false

# ---------------------------------------------------------------- encryption of external storage
# Encrypts everything stored on S3/FTP (local files stay unencrypted). Base64 key, create with:
#   php -r "echo base64_encode(sodium_crypto_secretstream_xchacha20poly1305_keygen());"
# Losing or changing the key makes everything already stored externally unreadable. See rtfm/ENCRYPTION.md
ENCRYPTION_KEY=
